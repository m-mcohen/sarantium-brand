{
  "name": "@sarantium/brand",
  "version": "0.4.0",
  "description": "Canonical Sarantium design tokens (palette, type scale, spacing, motion, layout) plus a Tailwind v4 theme and the sarantium-design skill. Single source of truth for sarantium-site, 5-day-close, and card-scanner.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "tokens.css",
    "README.md",
    "skill"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "sarantium",
    "design-tokens",
    "tailwind",
    "brand"
  ],
  "scripts": {
    "skill:build": "node scripts/build-skill-css.mjs",
    "skill:check": "node scripts/build-skill-css.mjs --check"
  }
}
